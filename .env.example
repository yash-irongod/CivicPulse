# Nivas — Environment Variables
# Copy to .env.local for local development. Never commit .env.local.

# --- Supabase (Postgres + PostGIS/pgvector, Auth, Storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the deployed app without trailing slash (e.g. https://nivas-rwa.vercel.app)
NEXT_PUBLIC_SITE_URL=

# --- Web Push Notifications (generate with: npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Scheduled Cron Jobs ---
# Bearer token checked by /api/jobs/* cron routes
CRON_SECRET=

# --- Founder Super Admin Console (/super-admin) ---
# Generate a strong random passphrase (24+ chars) to access /super-admin
SUPER_ADMIN_SECRET=

# --- AI Triage & Visual Evidence Check (Optional) ---
GEMINI_API_KEY=
GEMINI_MODEL_CLASSIFY=
GEMINI_MODEL_MULTIMODAL=

# --- Email Fallback (Optional) ---
RESEND_API_KEY=
